<footer class="site-footer">
  <div class="site-footer__inner">
    <small>{% if site.footer %}{{ site.footer | safe }}{% endif %}</small>
    <nav aria-label="Footer links">
      {% if site.enableContact == 1 %}<a href="/contact/">Contact</a>{% endif %}
      {% if site.enableNetlifyCMS == 1 %}<a href="{{ metadata.url }}/admin/">Admin</a>{% endif %}
      {% if site.enableGithubLink == 1 %}<a href="{{ site.githubUrl }}" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>{% endif %}
    </nav>
  </div>
</footer>
