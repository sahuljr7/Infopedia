<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <svg class="brand__mark" viewBox="0 0 56 48" aria-hidden="true" focusable="false">
        <path d="M2 30 25 7v15L2 45V30Zm27 4L54 9v15L29 47V34Z" fill="currentColor"/>
      </svg>
      <span>{{ site.name }}</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/explore/">Explore</a>
      <a href="/tags/">Tags</a>
      <a href="/about/">About</a>
    </nav>

    <div class="site-controls">
      {% if site.enableSearch == 1 %}
      <button id="searchToggle" class="icon-button" type="button" aria-label="Search (Ctrl+K)" aria-haspopup="dialog" onclick="toggleSearch()">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
      </button>
      {% endif %}

      {% if site.enableDarkMode == 1 %}
      <button class="icon-button" type="button" aria-label="Toggle dark mode" onclick="activateDarkMode()">
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.1A8.8 8.8 0 0 1 8.9 3.6 9 9 0 1 0 20.4 15.1Z"/></svg>
      </button>
      {% endif %}
    </div>
  </div>
</header>

{% if site.enableSearch == 1 %}
<div id="searchOverlay" class="search-overlay hidden" aria-hidden="true" onclick="closeSearch(event)">
  <section class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="searchDialogTitle">
    <h2 id="searchDialogTitle" class="sr-only">Search Infopedia</h2>
    <div class="search-dialog__input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
      <label class="sr-only" for="searchField">Search articles</label>
      <input id="searchField" type="search" placeholder="Search articles and topics..." autocomplete="off" aria-controls="searchResults">
      <button type="button" class="search-close" onclick="closeSearch()" aria-label="Close search">Esc</button>
    </div>
    <p id="searchStatus" class="search-status" role="status">Type to search Infopedia</p>
    <ul id="searchResults" class="search-results" role="listbox" aria-label="Search results"></ul>
  </section>
</div>
{% endif %}
