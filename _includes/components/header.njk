<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }} home">
      <svg class="brand__mark" viewBox="0 0 56 48" aria-hidden="true" focusable="false">
        <path d="M2 30 25 7v15L2 45V30Zm27 4L54 9v15L29 47V34Z" fill="currentColor"/>
      </svg>
      <span>{{ site.name }}</span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/#articles">Explore</a>
      <a href="/#topics">Tags</a>
      <a href="/#about">About</a>
    </nav>

    <div class="site-controls">
      {% if site.enableSearch == 1 %}
      <form class="search-control" role="search" onsubmit="return false">
        <button id="searchToggle" class="icon-button" type="button" aria-label="Search" aria-expanded="false" onclick="toggleSearch()">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
        </button>
        <label class="sr-only" for="searchField">Search Infopedia</label>
        <input id="searchField" class="search-field hidden" type="search" placeholder="Search articles" autocomplete="off">
        <ul id="searchResults" class="search-results hidden" tabindex="0"></ul>
        <div id="noResultsFound" class="search-empty hidden">No results found.</div>
      </form>
      {% endif %}

      {% if site.enableDarkMode == 1 %}
      <button class="icon-button" type="button" aria-label="Toggle dark mode" onclick="activateDarkMode()">
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.1A8.8 8.8 0 0 1 8.9 3.6 9 9 0 1 0 20.4 15.1Z"/></svg>
      </button>
      {% endif %}
    </div>
  </div>
</header>
