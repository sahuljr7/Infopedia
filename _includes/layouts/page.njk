---
layout: layouts/base.njk
section: page
---
<article class="article-shell">
  <header class="article-header">
    <div class="article-header__meta">
      {% if site.enableDatestamp == true %}
      <time datetime="{{ page.date | machineDate }}">Updated {{ page.date | readableDate }}</time>
      {% endif %}
      {% if site.enableEditButton == true %}
      <a class="edit-link" target="_blank" rel="noopener noreferrer" href="{{ site.githubUrl }}/edit/{{ site.githubBranch }}/{{ page.inputPath }}">Edit page</a>
      {% endif %}
    </div>
    <h1>{{ title }}</h1>
  </header>

  <div class="article-content">
    <div class="article-prose prose prose-lg">
      <div class="adjust">
        {{ layoutContent | safe }}
        {% if (site.enableComments) and (comments !== 0) %}
          <!-- Comments are added here when enabled for the page. -->
        {% endif %}
      </div>

      {% if site.enablePageNavigation == true %}
      <nav class="page-navigation" aria-label="More pages">
        {%- set nextPage = collections.menuItems | getNextCollectionItem(page) %}
        {%- if nextPage %}<a class="page-navigation__next" href="{{ nextPage.url | url }}"><span>Next</span><strong>{{ nextPage.data.eleventyNavigation.title or nextPage.data.eleventyNavigation.key }}</strong><span aria-hidden="true">→</span></a>{% endif %}
        {%- set previousPage = collections.menuItems | getPreviousCollectionItem(page) %}
        {%- if previousPage %}<a class="page-navigation__previous" href="{{ previousPage.url | url }}"><span>Previous</span><strong>{{ previousPage.data.eleventyNavigation.title or previousPage.data.eleventyNavigation.key }}</strong></a>{% endif %}
      </nav>
      {% endif %}
    </div>

    {% if site.enableTOC and toc %}
    <aside class="table-of-contents">
      <p>On this page</p>
      {{ content | toc | safe }}
    </aside>
    {% endif %}
  </div>
</article>
